{
  "name": "ideocode-gui",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-monaco.mjs",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck:all": "tsc --noEmit && pnpm --filter @ideocode/types typecheck && pnpm --filter @ideocode/mcp-apps typecheck && pnpm --filter @ideocode/automations typecheck && pnpm --filter @ideocode/enterprise-mcp-client typecheck"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ideocode/types": "workspace:*",
    "@ideocode/mcp-apps": "workspace:*",
    "@ideocode/automations": "workspace:*",
    "@ideocode/enterprise-mcp-client": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
