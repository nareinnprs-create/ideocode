{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "http:default",
    "http:allow-fetch",
    "http:allow-fetch-send",
    "http:allow-fetch-read-body",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": true },
        { "name": "cmd.exe", "cmd": "cmd.exe", "args": true },
        { "name": "sh", "cmd": "sh", "args": true },
        { "name": "bash", "cmd": "bash", "args": true },
        { "name": "zsh", "cmd": "zsh", "args": true },
        { "name": "pwsh", "cmd": "pwsh", "args": true },
        { "name": "powershell", "cmd": "powershell", "args": true },
        { "name": "cargo", "cmd": "cargo", "args": true },
        { "name": "npm", "cmd": "npm", "args": true },
        { "name": "node", "cmd": "node", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": true },
        { "name": "cmd.exe", "cmd": "cmd.exe", "args": true },
        { "name": "sh", "cmd": "sh", "args": true },
        { "name": "bash", "cmd": "bash", "args": true },
        { "name": "zsh", "cmd": "zsh", "args": true },
        { "name": "pwsh", "cmd": "pwsh", "args": true },
        { "name": "powershell", "cmd": "powershell", "args": true },
        { "name": "cargo", "cmd": "cargo", "args": true },
        { "name": "npm", "cmd": "npm", "args": true },
        { "name": "node", "cmd": "node", "args": true }
      ]
    }
  ]
}
